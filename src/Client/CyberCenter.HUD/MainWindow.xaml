<Window x:Class="CyberCenter.HUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberCenter Gaming HUD"
        Height="54" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="800" Top="16"
        MouseDown="Window_MouseDown"
        FontFamily="Segoe UI, Cairo, Tahoma">

    <Window.Resources>
        <SolidColorBrush x:Key="BgHud" Color="#F0090D16"/>
        <SolidColorBrush x:Key="BorderCyan" Color="#3306B6D4"/>
        <SolidColorBrush x:Key="BorderAmber" Color="#66F59E0B"/>
        <SolidColorBrush x:Key="BorderRose" Color="#99F43F5E"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#06B6D4"/>
        <SolidColorBrush x:Key="EmeraldAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="AmberAccent" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RoseAccent" Color="#F43F5E"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
    </Window.Resources>

    <!-- Main Draggable HUD Container with Subtle Glassmorphism -->
    <Border x:Name="HudContainer" Background="{StaticResource BgHud}" BorderBrush="{StaticResource BorderCyan}" BorderThickness="1.5" CornerRadius="16" Padding="14,6" Cursor="SizeAll">
        <DockPanel VerticalAlignment="Center" LastChildFill="True">
            
            <!-- Left: Station Badge & Live Network Indicator -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border Background="#141C2E" BorderBrush="{StaticResource CyanAccent}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
                    <TextBlock Text="ST-04" FontWeight="Black" FontSize="11" Foreground="{StaticResource CyanAccent}"/>
                </Border>
                <Ellipse x:Name="PingDot" Width="7" Height="7" Fill="{StaticResource EmeraldAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSpeed" Text="↓ 62 MB/s" FontSize="10" Foreground="{StaticResource TextMuted}" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </StackPanel>

            <!-- Right: Quick Menu Pill Button -->
            <Border DockPanel.Dock="Right" Background="#141C2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="QuickMenu_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ F8 القائمة" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                </StackPanel>
            </Border>

            <!-- Center: Remaining Time Countdown -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="الوقت: " FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtHudCountdown" Text="01:45:20" FontWeight="Black" FontSize="14" Foreground="{StaticResource TextMain}" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
            </StackPanel>

        </DockPanel>
    </Border>
</Window>
