<Window x:Class="CyberCenter.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberCenter Client Gaming Shell"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#07090E"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Cairo, Tahoma"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Dark Styles & Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#07090E"/>
        <SolidColorBrush x:Key="BgCard" Color="#0E131F"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#141C2E"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#334155"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#06B6D4"/>
        <SolidColorBrush x:Key="EmeraldAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="AmberAccent" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RoseAccent" Color="#F43F5E"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- Custom Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="#07090E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#141C2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP MAIN HEADER ================= -->
        <Border Grid.Row="0" Background="#0A0E17" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="True">
                <!-- Left: Branding & Station Info -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#141C2E" BorderBrush="{StaticResource CyanAccent}" BorderThickness="1.5" CornerRadius="8" Padding="8,4" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CYBER" FontWeight="Black" FontSize="20" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    <TextBlock Text="CENTER" FontWeight="Black" FontSize="20" Foreground="{StaticResource CyanAccent}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    
                    <Border Background="#141C2E" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Margin="20,0,0,0" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStationNumber" Text="#04" FontSize="12" FontWeight="Black" Foreground="{StaticResource CyanAccent}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Status, Clock, Assistance -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Call Staff Button -->
                    <Button x:Name="BtnCallStaff" Style="{StaticResource CyberSecondaryButton}" Click="BtnCallStaff_Click" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔 استدعاء المشرف" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Network Ping Indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldAccent}" Margin="0,0,6,0"/>
                        <TextBlock Text="الخادم متصل (4ms)" FontSize="11" Foreground="{StaticResource EmeraldAccent}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Live Clock -->
                    <TextBlock x:Name="TxtLiveClock" Text="16:45:00" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= CENTER MAIN CONTENT AREA ================= -->
        <Grid Grid.Row="1">
            <!-- MODE 1: LOCKED WELCOME SCREEN -->
            <Grid x:Name="PanelLockedWelcome" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Specs Showcase & Center Features -->
                <Border Grid.Column="0" Background="#0A0E17" Padding="48" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel>
                            <Border Background="#10B981" Opacity="0.1" CornerRadius="20" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16">
                                <TextBlock Text="🟢 المحطة جاهزة ومتاحة للاستخدام" Foreground="{StaticResource EmeraldAccent}" FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <TextBlock Text="صالة الألعاب الإلكترونية الأولى" FontSize="36" FontWeight="Black" Foreground="{StaticResource TextMain}" LineHeight="46"/>
                            <TextBlock Text="أقوى عتاد ألعاب احترافي، شاشات 240Hz، وباندويث مخصص للألعاب التنافسية." FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,12,0,32" TextWrapping="Wrap"/>

                            <!-- Station Specs Grid -->
                            <UniformGrid Columns="2" Margin="0,0,0,32">
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="بطاقة الرسوميات" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="RTX 4080 Super 16GB" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="الشاشة ومعدل التحديث" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="27'' OLED 240Hz 0.03ms" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="المعالج والذاكرة" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="Core i7 14700KF • 32GB DDR5" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="سرعة الشبكة والإنترنت" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="10Gbps LAN • 4ms Gaming Ping" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="💡 نصيحة: يمكنك الحصول على كروت الدقائق مباشرة من الكاشير أو شحن حسابك الدائم." FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Login Card & Credentials -->
                <Border Grid.Column="1" Background="{StaticResource BgDark}" Padding="48">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="20" Padding="36">
                            <StackPanel>
                                <TextBlock Text="تسجيل الدخول للمحطة" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                                <TextBlock Text="أدخل رمز الكرت أو بيانات حساب المشترك لبدء الجلسة" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,24"/>

                                <!-- Tabs Switcher -->
                                <Border Background="#07090E" CornerRadius="10" Padding="4" Margin="0,0,0,20">
                                    <UniformGrid Columns="2">
                                        <Button x:Name="TabBtnCard" Content="كروت الدقائق (PIN)" Background="{StaticResource CyanAccent}" Foreground="#07090E" FontWeight="Bold" FontSize="12" Padding="8,8" Click="TabBtnCard_Click"/>
                                        <Button x:Name="TabBtnMember" Content="عضو دائم (Member)" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12" Padding="8,8" Click="TabBtnMember_Click"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Card PIN Form -->
                                <StackPanel x:Name="FormCardPin" Visibility="Visible">
                                    <TextBlock Text="رمز الكرت المؤقت (16 رقماً)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtCardPin" Height="48" Background="#07090E" Foreground="{StaticResource CyanAccent}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.5" FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalContentAlignment="Center" Padding="14,10" TextAlignment="Center" TextChanged="TxtCardPin_TextChanged"/>
                                    <TextBlock Text="مثال: 5892-4410-9182-3341" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,16" HorizontalAlignment="Center"/>

                                    <Button x:Name="BtnStartCardSession" Style="{StaticResource CyberButton}" Content="بدء اللعب الآن 🚀" Height="48" Click="BtnStartCardSession_Click"/>
                                </StackPanel>

                                <!-- Member Credentials Form -->
                                <StackPanel x:Name="FormMember" Visibility="Collapsed">
                                    <TextBlock Text="اسم المستخدم (Username)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtMemberUsername" Height="44" Background="#07090E" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.5" FontSize="14" VerticalContentAlignment="Center" Padding="12,8" Margin="0,0,0,14"/>

                                    <TextBlock Text="كلمة المرور (Password)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="TxtMemberPassword" Height="44" Background="#07090E" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.5" FontSize="14" VerticalContentAlignment="Center" Padding="12,8" Margin="0,0,0,20"/>

                                    <Button x:Name="BtnStartMemberSession" Style="{StaticResource CyberButton}" Content="تسجيل الدخول وبدء الجلسة" Height="48" Click="BtnStartMemberSession_Click"/>
                                </StackPanel>

                                <Separator Background="{StaticResource BorderDark}" Margin="0,24,0,16"/>

                                <TextBlock Text="جلسة مفتوحة؟ يرجى إبلاغ الكاشير لفتح المحطة من لوحة التحكم" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- MODE 2: ACTIVE SESSION & GAMES BROWSER -->
            <Grid x:Name="PanelActiveSession" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Active Session Ribbon Bar -->
                <Border Grid.Row="0" Background="#0A0E17" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="24,12">
                    <DockPanel LastChildFill="True">
                        <!-- Left: Current Player & Time Status -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- Player Badge -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtActiveUser" Text="عمر القحطاني (@omar99)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock x:Name="TxtSessionType" Text="جلسة عضو دائم (VIP Member)" FontSize="10" Foreground="{StaticResource CyanAccent}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Remaining Countdown Timer -->
                            <Border x:Name="BorderTimer" Background="#141C2E" BorderBrush="{StaticResource CyanAccent}" BorderThickness="1.5" CornerRadius="10" Padding="16,6" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="الوقت المتبقي: " FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtRemainingCountdown" Text="01:45:20" FontFamily="Consolas, monospace" FontSize="16" FontWeight="Black" Foreground="{StaticResource CyanAccent}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Financial Meter (Wallet or Cost) -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳 الرصيد / التكلفة: " FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtActiveCost" Text="14,500 ر.ي" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AmberAccent}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Action Buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Order Snacks Button -->
                            <Button Style="{StaticResource CyberSecondaryButton}" Click="BtnOrderSnacks_Click" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🍔 متجر المأكولات والمشروبات" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- Pause / Screen Lock -->
                            <Button Style="{StaticResource CyberSecondaryButton}" Click="BtnPauseLock_Click" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 قفل مؤقت" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- End Session Logout -->
                            <Button Background="{StaticResource RoseAccent}" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="11" Padding="14,8" BorderThickness="0" Cursor="Hand" Click="BtnLogoutSession_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="تسجيل الخروج (Logout)"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search & Filter Category Bar -->
                <Border Grid.Row="1" Background="{StaticResource BgDark}" Padding="24,16,24,8">
                    <DockPanel LastChildFill="True">
                        <!-- Search Box -->
                        <Border DockPanel.Dock="Left" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Width="300" Padding="10,6" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSearchGame" Width="260" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center" TextChanged="TxtSearchGame_TextChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Category Filter Pills -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="الكل (All)" Style="{StaticResource CyberSecondaryButton}" Tag="All" Click="FilterCategory_Click" Margin="0,0,8,0"/>
                            <Button Content="تصويب وشوتينج" Style="{StaticResource CyberSecondaryButton}" Tag="Shooters &amp; FPS" Click="FilterCategory_Click" Margin="0,0,8,0"/>
                            <Button Content="باتل رويال" Style="{StaticResource CyberSecondaryButton}" Tag="Battle Royale" Click="FilterCategory_Click" Margin="0,0,8,0"/>
                            <Button Content="كرة قدم وسباقات" Style="{StaticResource CyberSecondaryButton}" Tag="Sports &amp; Racing" Click="FilterCategory_Click" Margin="0,0,8,0"/>
                            <Button Content="أكشن ومغامرات" Style="{StaticResource CyberSecondaryButton}" Tag="Action &amp; Adventure" Click="FilterCategory_Click" Margin="0,0,8,0"/>
                            <Button Content="برامج وأدوات" Style="{StaticResource CyberSecondaryButton}" Tag="Apps &amp; Tools" Click="FilterCategory_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Games & Launchers Grid View -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,8,24,24">
                    <ItemsControl x:Name="GamesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="16" Width="260" Height="220" Margin="0,0,16,16" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header: Category & Badge -->
                                        <DockPanel Grid.Row="0">
                                            <Border Background="#141C2E" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="4" Padding="6,2" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="{Binding IconColor}" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Black" Foreground="#07090E"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Card Center: Title & Description -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Black" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Card Footer: Play Button -->
                                        <Button Grid.Row="2" Style="{StaticResource CyberButton}" Content="تشغيل اللعبة ▶" Height="36" Tag="{Binding Title}" Click="BtnLaunchGame_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= BOTTOM STATUS FOOTER ================= -->
        <Border Grid.Row="2" Background="#0A0E17" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="CyberCenter Gaming System • Windows Protected Environment" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text=" • اضغط F8 لفتح القائمة السريعة" FontSize="11" Foreground="{StaticResource CyanAccent}" FontWeight="Bold" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Station Shell Engine v1.0.0" FontSize="11" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
