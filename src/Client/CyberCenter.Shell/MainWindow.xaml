<Window x:Class="CyberCenter.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberCenter Client Shell"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#07090E"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Tahoma">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#0E131F" BorderBrush="#253350" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="CYBER" FontWeight="Bold" FontSize="20" Foreground="#F8FAFC"/>
                    <TextBlock Text="CENTER" FontWeight="ExtraBold" FontSize="20" Foreground="#06B6D4" Margin="4,0,0,0"/>
                    <Border Background="#141C2E" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="6" Margin="16,0,0,0" Padding="8,2">
                        <TextBlock Text="STATION #04" FontWeight="Bold" FontSize="12" Foreground="#06B6D4"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="System Protected • No Cheat Injection" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Center Login & Games Welcome Area -->
        <Border Grid.Row="1" Background="#07090E" Padding="40">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <Border Background="#141C2E" BorderBrush="#253350" BorderThickness="1" CornerRadius="16" Padding="32">
                    <StackPanel>
                        <TextBlock Text="مرحباً بك في صالة الألعاب" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                        <TextBlock Text="أدخل رمز الكرت المؤقت (16 رقماً) أو سجل دخول بعضويتك" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,24" TextWrapping="Wrap" TextAlignment="Center"/>

                        <TextBlock Text="رمز الكرت (Card PIN)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCardPin" Height="44" Background="#0E131F" Foreground="#06B6D4" BorderBrush="#253350" BorderThickness="1" FontSize="16" FontWeight="Bold" Padding="12,10" VerticalContentAlignment="Center"/>

                        <Button x:Name="BtnLogin" Content="بدء الجلسة الآن" Height="46" Background="#06B6D4" Foreground="#07090E" FontWeight="Bold" FontSize="14" Margin="0,16,0,0" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click"/>

                        <Separator Background="#253350" Margin="0,20,0,20"/>

                        <Button Content="تسجيل دخول الأعضاء (Member Login)" Height="38" Background="#0E131F" Foreground="#F8FAFC" BorderBrush="#253350" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0E131F" BorderBrush="#253350" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock Text="خادم المركز: متصل (SignalR 100%)" FontSize="11" Foreground="#10B981" DockPanel.Dock="Left"/>
                <TextBlock Text="CyberCenter Shell v1.0.0" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

